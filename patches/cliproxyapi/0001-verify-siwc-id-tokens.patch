@@ -0,0 +1,99 @@
+package management
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/testutil/siwctest"
+)
+
+type siwcVerificationTransport func(*http.Request) (*http.Response, error)
+
+func (f siwcVerificationTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestSIWCManagementVerifiesBeforeSaving(t *testing.T) {
+	for _, mode := range []string{"valid", "signature", "nonce", "issuer", "audience"} {
+		t.Run(mode, func(t *testing.T) {
+			key, otherKey := siwctest.NewKey(t), siwctest.NewKey(t)
+			var idToken atomic.Value
+			var exchanges atomic.Int32
+			previousTransport := http.DefaultTransport
+			t.Cleanup(func() { http.DefaultTransport = previousTransport })
+			http.DefaultTransport = siwcVerificationTransport(func(req *http.Request) (*http.Response, error) {
+				var body string
+				switch req.URL.String() {
+				case codex.SIWCTokenURL:
+					exchanges.Add(1)
+					body = siwctest.Response(t, idToken.Load().(string))
+				case "https://auth.openai.com/.well-known/jwks.json":
+					body = siwctest.JWKS(t, key, "test-key")
+				default:
+					return nil, errors.New("unexpected network request")
+				}
+				return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"application/json"}}, Body: io.NopCloser(strings.NewReader(body))}, nil
+			})
+			f := setupSIWCFlow(t, false)
+			f.h.siwcOAuthFactory = func(cfg *config.Config) siwcOAuthService {
+				return codex.NewCodexAuth(cfg)
+			}
+			beforeDisk, errRead := os.ReadFile(f.path)
+			if errRead != nil {
+				t.Fatal(errRead)
+			}
+			beforeMemory, _ := f.manager.GetByID(f.auth.ID)
+			beforeDoc := ojson.NewDocString("{}")
+			if errSet := beforeDoc.Set("metadata", beforeMemory.Metadata); errSet != nil {
+				t.Fatal(errSet)
+			}
+			state, flow := f.start(t)
+			signingKey := key
+			if mode == "signature" {
+				signingKey = otherKey
+			}
+			idToken.Store(siwctest.Token(t, signingKey, "test-key", "oaiapp_issued", flow.nonce, func(doc *ojson.Doc) {
+				field := map[string]string{"nonce": "nonce", "issuer": "iss", "audience": "aud"}[mode]
+				if field != "" {
+					if errSet := doc.Set(field, "wrong-value"); errSet != nil {
+						t.Fatal(errSet)
+					}
+				}
+			}))
+			w := siwcRequest(t, f.router, http.MethodPost, "/callback", map[string]any{"redirect_url": siwcCallbackURL(state)})
+			if w.Code != http.StatusOK {
+				t.Fatalf("callback status %d", w.Code)
+			}
+			waitSIWCExchange(t, flow)
+			if exchanges.Load() != 1 {
+				t.Fatal("unexpected token exchange count")
+			}
+			afterDisk, errRead := os.ReadFile(f.path)
+			if errRead != nil {
+				t.Fatal(errRead)
+			}
+			afterMemory, _ := f.manager.GetByID(f.auth.ID)
+			afterDoc := ojson.NewDocString("{}")
+			if errSet := afterDoc.Set("metadata", afterMemory.Metadata); errSet != nil {
+				t.Fatal(errSet)
+			}
+			status := performOAuthStatusRequest(t, f.router, state)
+			if mode == "valid" {
+				if status.Status != "ok" || afterMemory.Metadata["use_siwc"] != true ||
+					ojson.GetBytes(afterDisk, "siwc.refresh_token").String() != "new-refresh" {
+					t.Fatal("verified credentials not saved")
+				}
+			} else if status.Status != "error" || string(afterDisk) != string(beforeDisk) || beforeDoc.String() != afterDoc.String() {
+				t.Fatal("rejected ID token changed disk or live credentials")
+			}
+		})
+	}
+}
