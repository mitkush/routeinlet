diff --git a/internal/testutil/siwctest/tokens.go b/internal/testutil/siwctest/tokens.go
new file mode 100644
--- /dev/null
+++ b/internal/testutil/siwctest/tokens.go
@@ -0,0 +1,85 @@
+// Package siwctest supplies synthetic, signed tokens for offline auth tests.
+// It has no production consumers and never contains real credentials.
+package siwctest
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/base64"
+	"github.com/MoeForge/moego/ojson"
+	"github.com/go-jose/go-jose/v4"
+)
+
+func NewKey(t *testing.T) *rsa.PrivateKey {
+	t.Helper()
+	key, errKey := rsa.GenerateKey(rand.Reader, 2048)
+	if errKey != nil {
+		t.Fatal(errKey)
+	}
+	return key
+}
+
+func Token(t *testing.T, key *rsa.PrivateKey, kid, clientID, nonce string, mutate func(*ojson.Doc)) string {
+	t.Helper()
+	now := time.Now().Unix()
+	doc := ojson.NewDocString("{}")
+	for name, value := range map[string]any{
+		"iss": "https://auth.openai.com", "sub": "synthetic-subject",
+		"aud": clientID, "nonce": nonce, "iat": now, "exp": now + 3600,
+	} {
+		if errSet := doc.Set(name, value); errSet != nil {
+			t.Fatal(errSet)
+		}
+	}
+	if mutate != nil {
+		mutate(doc)
+	}
+	signer, errSigner := jose.NewSigner(jose.SigningKey{
+		Algorithm: jose.RS256,
+		Key:       jose.JSONWebKey{Key: key, KeyID: kid},
+	}, nil)
+	if errSigner != nil {
+		t.Fatal(errSigner)
+	}
+	signed, errSign := signer.Sign(doc.Bytes())
+	if errSign != nil {
+		t.Fatal(errSign)
+	}
+	raw, errSerialize := signed.CompactSerialize()
+	if errSerialize != nil {
+		t.Fatal(errSerialize)
+	}
+	return raw
+}
+
+func JWKS(t *testing.T, key *rsa.PrivateKey, kid string) string {
+	t.Helper()
+	doc := ojson.NewDocString("{}")
+	if errSet := doc.Set("keys", []map[string]any{{
+		"kty": "RSA", "use": "sig", "alg": "RS256", "kid": kid,
+		"n": base64.RawURLEncoding.EncodeToString(key.N.Bytes()),
+		"e": base64.RawURLEncoding.EncodeToString(big.NewInt(int64(key.E)).Bytes()),
+	}}); errSet != nil {
+		t.Fatal(errSet)
+	}
+	return doc.String()
+}
+
+func Response(t *testing.T, idToken string) string {
+	t.Helper()
+	doc := ojson.NewDocString("{}")
+	for name, value := range map[string]any{
+		"access_token": "new", "refresh_token": "new-refresh",
+		"id_token": idToken, "expires_in": 3600,
+		"scope": "openid profile email offline_access resource.invoke chatgpt.tokens.use.direct",
+	} {
+		if errSet := doc.Set(name, value); errSet != nil {
+			t.Fatal(errSet)
+		}
+	}
+	return doc.String()
+}
