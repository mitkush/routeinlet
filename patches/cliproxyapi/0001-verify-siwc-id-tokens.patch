+package codex
+
+import (
+	"context"
+	"crypto"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/base64"
+	"github.com/MoeForge/moego/ojson"
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/testutil/siwctest"
+)
+
+// Existing parser/refresh tests can use a real signed initial ID token without
+// adding network requests or weakening the production verifier.
+func testSIWCIDToken(t *testing.T, auth *CodexAuth, clientID string) string {
+	t.Helper()
+	key := siwctest.NewKey(t)
+	auth.siwcKeySet = &oidc.StaticKeySet{PublicKeys: []crypto.PublicKey{&key.PublicKey}}
+	return siwctest.Token(t, key, "test-key", clientID, "test-nonce", nil)
+}
+
+func TestSIWCExchangeVerifiesIDToken(t *testing.T) {
+	key := siwctest.NewKey(t)
+	otherKey := siwctest.NewKey(t)
+	const clientID = "oaiapp_test"
+	const nonce = "attempt-nonce"
+	for _, tc := range []struct {
+		name   string
+		claims map[string]any
+		drop   string
+		mode   string
+		ok     bool
+	}{
+		{name: "valid", ok: true},
+		{name: "array audience", claims: map[string]any{"aud": []string{clientID}}, ok: true},
+		{name: "multiple audiences with azp", claims: map[string]any{"aud": []string{clientID, "other"}, "azp": clientID}, ok: true},
+		{name: "bad signature", mode: "other-key"},
+		{name: "unknown kid", mode: "unknown-kid"},
+		{name: "malformed", mode: "malformed"},
+		{name: "unsigned", mode: "none"},
+		{name: "HMAC confusion", mode: "HS256"},
+		{name: "bad issuer", claims: map[string]any{"iss": "https://untrusted.invalid"}},
+		{name: "bad audience", claims: map[string]any{"aud": "another-client"}},
+		{name: "bad nonce", claims: map[string]any{"nonce": "another-attempt"}},
+		{name: "missing nonce", drop: "nonce"},
+		{name: "expired", claims: map[string]any{"exp": time.Now().Add(-time.Minute).Unix()}},
+		{name: "missing expiry", drop: "exp"},
+		{name: "missing iat", drop: "iat"},
+		{name: "future iat", claims: map[string]any{"iat": time.Now().Add(time.Hour).Unix()}},
+		{name: "future nbf within library leeway", claims: map[string]any{"nbf": time.Now().Add(time.Minute).Unix()}},
+		{name: "empty subject", claims: map[string]any{"sub": ""}},
+		{name: "missing subject", drop: "sub"},
+		{name: "wrong claim type", claims: map[string]any{"nonce": 123}},
+		{name: "multiple audiences missing azp", claims: map[string]any{"aud": []string{clientID, "other"}}},
+		{name: "wrong azp", claims: map[string]any{"azp": "another-client"}},
+		{name: "bad access token hash", claims: map[string]any{"at_hash": "incorrect"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			signingKey, kid := key, "test-key"
+			if tc.mode == "other-key" {
+				signingKey = otherKey
+			}
+			if tc.mode == "unknown-kid" {
+				kid = "missing-key"
+			}
+			token := siwctest.Token(t, signingKey, kid, clientID, nonce, func(doc *ojson.Doc) {
+				for name, value := range tc.claims {
+					if errSet := doc.Set(name, value); errSet != nil {
+						t.Fatal(errSet)
+					}
+				}
+				if tc.drop != "" {
+					if errDelete := doc.Delete(tc.drop); errDelete != nil {
+						t.Fatal(errDelete)
+					}
+				}
+			})
+			if tc.mode == "malformed" {
+				token = "not-a-jwt"
+			}
+			if tc.mode == "none" || tc.mode == "HS256" {
+				parts := strings.Split(token, ".")
+				header := ojson.NewDocString("{}")
+				if errSet := header.Set("alg", tc.mode); errSet != nil {
+					t.Fatal(errSet)
+				}
+				token = base64.RawURLEncoding.EncodeToString(header.Bytes()) + "." + parts[1] + "." + parts[2]
+			}
+			var keyRequests atomic.Int32
+			client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				body := ""
+				switch req.URL.String() {
+				case SIWCTokenURL:
+					if errForm := req.ParseForm(); errForm != nil {
+						return nil, errForm
+					}
+					if req.Form.Get("code_verifier") != "verifier" || req.Form.Get("client_id") != clientID {
+						t.Error("lost PKCE or issued client ID")
+					}
+					body = siwctest.Response(t, token)
+				case siwcJWKSURL:
+					if req.Header.Get("Authorization") != "" {
+						t.Error("credentials sent to JWKS")
+					}
+					keyRequests.Add(1)
+					body = siwctest.JWKS(t, key, "test-key")
+				default:
+					return nil, errors.New("unexpected network request")
+				}
+				return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"application/json"}}, Body: io.NopCloser(strings.NewReader(body))}, nil
+			})}
+			auth := &CodexAuth{httpClient: client, siwcKeySet: newSIWCKeySet(client)}
+			tokens, errExchange := auth.ExchangeSIWCCodeForTokens(context.Background(), "code", clientID, SIWCRedirectURI, "", &PKCECodes{CodeVerifier: "verifier"}, nonce)
+			if tc.ok {
+				if errExchange != nil || tokens == nil {
+					t.Fatalf("valid signed token rejected: %v", errExchange)
+				}
+				if keyRequests.Load() != 1 {
+					t.Fatal("valid token did not use the trusted JWKS")
+				}
+			} else if errExchange == nil || tokens != nil {
+				t.Fatal("invalid token returned credentials")
+			} else if errExchange.Error() != "SIWC ID token verification failed; start a new sign-in" {
+				t.Fatalf("verification error may expose claims: %v", errExchange)
+			}
+		})
+	}
+}
+
+func TestSIWCExchangeRequiresPendingNonceAndIssuedClient(t *testing.T) {
+	var requests atomic.Int32
+	auth := &CodexAuth{httpClient: &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		requests.Add(1)
+		return nil, errors.New("must not exchange")
+	})}}
+	for _, tc := range []struct{ client, nonce string }{
+		{"oaiapp_test", ""}, {"oaiapp_test", " "}, {"", "nonce"}, {SIWCDynamicClientID, "nonce"},
+	} {
+		tokens, errExchange := auth.ExchangeSIWCCodeForTokens(context.Background(), "code", tc.client, "", "", &PKCECodes{CodeVerifier: "verifier"}, tc.nonce)
+		if errExchange == nil || tokens != nil {
+			t.Fatal("accepted incomplete transaction")
+		}
+	}
+	if requests.Load() != 0 {
+		t.Fatal("incomplete transaction made a token request")
+	}
+}
+
+func TestSIWCJWKSCacheRotationAndFailure(t *testing.T) {
+	key1, key2 := siwctest.NewKey(t), siwctest.NewKey(t)
+	var requests atomic.Int32
+	var keys atomic.Value
+	keys.Store(siwctest.JWKS(t, key1, "one"))
+	client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if req.URL.String() != siwcJWKSURL {
+			return nil, errors.New("unexpected key URL")
+		}
+		requests.Add(1)
+		return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"application/json"}}, Body: io.NopCloser(strings.NewReader(keys.Load().(string)))}, nil
+	})}
+	auth := &CodexAuth{siwcKeySet: newSIWCKeySet(client)}
+	token := &CodexSIWCTokenData{ClientID: "oaiapp_test", IDToken: siwctest.Token(t, key1, "one", "oaiapp_test", "nonce", nil)}
+	for i := 0; i < 2; i++ {
+		if errVerify := auth.verifySIWCIDToken(context.Background(), token, "nonce"); errVerify != nil {
+			t.Fatal(errVerify)
+		}
+	}
+	if requests.Load() != 1 {
+		t.Fatal("keys not cached")
+	}
+	keys.Store(siwctest.JWKS(t, key2, "two"))
+	token.IDToken = siwctest.Token(t, key2, "two", "oaiapp_test", "nonce", nil)
+	if errVerify := auth.verifySIWCIDToken(context.Background(), token, "nonce"); errVerify != nil || requests.Load() != 2 {
+		t.Fatalf("key rotation failed: %v", errVerify)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if errVerify := auth.verifySIWCIDToken(ctx, token, "nonce"); errVerify == nil {
+		t.Fatal("cancelled verification accepted")
+	}
+	// A new verifier has no cached key; malformed JWKS must fail closed.
+	keys.Store("not-json")
+	auth.siwcKeySet = newSIWCKeySet(client)
+	if errVerify := auth.verifySIWCIDToken(context.Background(), token, "nonce"); errVerify == nil {
+		t.Fatal("malformed JWKS accepted")
+	}
+}
+
+func TestSIWCJWKSDoesNotFollowRedirects(t *testing.T) {
+	var redirected atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		redirected.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer target.Close()
+	client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if req.URL.String() == siwcJWKSURL {
+			return &http.Response{StatusCode: 302, Header: http.Header{"Location": {target.URL}}, Body: io.NopCloser(strings.NewReader(""))}, nil
+		}
+		return http.DefaultTransport.RoundTrip(req)
+	})}
+	key := siwctest.NewKey(t)
+	auth := &CodexAuth{siwcKeySet: newSIWCKeySet(client)}
+	token := &CodexSIWCTokenData{ClientID: "oaiapp_test", IDToken: siwctest.Token(t, key, "key", "oaiapp_test", "nonce", nil)}
+	if errVerify := auth.verifySIWCIDToken(context.Background(), token, "nonce"); errVerify == nil || redirected.Load() != 0 {
+		t.Fatal("redirected JWKS accepted or contacted")
+	}
+}
+
+type siwcTestKeySet func(context.Context, string) ([]byte, error)
+
+func (f siwcTestKeySet) VerifySignature(ctx context.Context, token string) ([]byte, error) {
+	return f(ctx, token)
+}
+
+func TestSIWCExpiryCheckedAfterKeyFetch(t *testing.T) {
+	key := siwctest.NewKey(t)
+	clock := time.Date(2026, time.November, 25, 12, 0, 0, 0, time.UTC)
+	start := clock
+	token := &CodexSIWCTokenData{ClientID: "oaiapp_test", IDToken: siwctest.Token(t, key, "key", "oaiapp_test", "nonce", func(doc *ojson.Doc) {
+		if errSet := doc.Set("iat", start.Unix()); errSet != nil {
+			t.Fatal(errSet)
+		}
+		if errSet := doc.Set("exp", start.Add(time.Minute).Unix()); errSet != nil {
+			t.Fatal(errSet)
+		}
+	})}
+	keys := &oidc.StaticKeySet{PublicKeys: []crypto.PublicKey{&key.PublicKey}}
+	auth := &CodexAuth{siwcKeySet: siwcTestKeySet(func(ctx context.Context, raw string) ([]byte, error) {
+		// Model time passing during key retrieval without sleeping.
+		clock = clock.Add(2 * time.Minute)
+		return keys.VerifySignature(ctx, raw)
+	})}
+	if errVerify := auth.verifySIWCIDTokenWithClock(context.Background(), token, "nonce", func() time.Time { return clock }); errVerify == nil {
+		t.Fatal("token that expired during key retrieval was accepted")
+	}
+}
