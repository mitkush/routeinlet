diff --git a/internal/auth/codex/siwc_id_token.go b/internal/auth/codex/siwc_id_token.go
new file mode 100644
--- /dev/null
+++ b/internal/auth/codex/siwc_id_token.go
@@ -0,0 +1,87 @@
+package codex
+
+import (
+	"context"
+	"crypto/subtle"
+	"errors"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+)
+
+// These trust anchors and RS256 come from OpenAI's production discovery
+// document. Neither the callback nor the JWT can choose an issuer or key URL.
+const (
+	siwcIssuer  = "https://auth.openai.com"
+	siwcJWKSURL = "https://auth.openai.com/.well-known/jwks.json"
+)
+
+type siwcSignatureKeySet interface {
+	VerifySignature(context.Context, string) ([]byte, error)
+}
+
+func newSIWCKeySet(client *http.Client) siwcSignatureKeySet {
+	keyClient := *client
+	// Only credential acquisition is bounded; inference transports are untouched.
+	keyClient.Timeout = 15 * time.Second
+	keyClient.CheckRedirect = func(*http.Request, []*http.Request) error {
+		return http.ErrUseLastResponse
+	}
+	return oidc.NewRemoteKeySet(oidc.ClientContext(context.Background(), &keyClient), siwcJWKSURL)
+}
+
+// verifySIWCIDToken is called only for authorization-code grants. Refresh does
+// not have a new authorization nonce and must retain its rotation/journal rules.
+func (o *CodexAuth) verifySIWCIDToken(ctx context.Context, tokens *CodexSIWCTokenData, expectedNonce string) error {
+	return o.verifySIWCIDTokenWithClock(ctx, tokens, expectedNonce, time.Now)
+}
+
+func (o *CodexAuth) verifySIWCIDTokenWithClock(ctx context.Context, tokens *CodexSIWCTokenData, expectedNonce string, nowFunc func() time.Time) error {
+	// Verification errors can contain token claims or JWKS response bodies.
+	// Return a fixed error so callers cannot accidentally log those values.
+	invalid := errors.New("SIWC ID token verification failed; start a new sign-in")
+	if o == nil || o.siwcKeySet == nil || tokens == nil || strings.TrimSpace(expectedNonce) == "" || ctx.Err() != nil {
+		return invalid
+	}
+	verifier := oidc.NewVerifier(siwcIssuer, o.siwcKeySet, &oidc.Config{
+		ClientID:             tokens.ClientID,
+		SupportedSigningAlgs: []string{oidc.RS256},
+		Now:                  nowFunc,
+	})
+	identity, errVerify := verifier.Verify(ctx, tokens.IDToken)
+	if errVerify != nil || ctx.Err() != nil {
+		return invalid
+	}
+	now := nowFunc()
+	if !identity.Expiry.After(now) ||
+		strings.TrimSpace(identity.Subject) == "" ||
+		identity.IssuedAt.IsZero() ||
+		identity.IssuedAt.After(now.Add(5*time.Second)) ||
+		!identity.Expiry.After(identity.IssuedAt) ||
+		subtle.ConstantTimeCompare([]byte(identity.Nonce), []byte(expectedNonce)) != 1 {
+		return invalid
+	}
+	var extra struct {
+		AuthorizedParty string   `json:"azp"`
+		NotBefore       *float64 `json:"nbf"`
+	}
+	if errClaims := identity.Claims(&extra); errClaims != nil {
+		return invalid
+	}
+	// Tighten go-oidc's default five-minute nbf leeway to five seconds.
+	if extra.NotBefore != nil && *extra.NotBefore > float64(now.Unix())+5 {
+		return invalid
+	}
+	if (len(identity.Audience) > 1 && extra.AuthorizedParty == "") ||
+		(extra.AuthorizedParty != "" && extra.AuthorizedParty != tokens.ClientID) {
+		return invalid
+	}
+	if identity.AccessTokenHash != "" {
+		if errHash := identity.VerifyAccessToken(tokens.AccessToken); errHash != nil {
+			return invalid
+		}
+	}
+	return nil
+}
