diff --git a/internal/auth/codex/siwc_binding.go b/internal/auth/codex/siwc_binding.go
new file mode 100644
index 0000000..3c9241b
--- /dev/null
+++ b/internal/auth/codex/siwc_binding.go
@@ -0,0 +1,183 @@
+package codex
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/google/uuid"
+)
+
+var errSIWCIdentity = errors.New("SIWC account association could not be verified; renew the selected Codex login and start a new binding")
+
+// SIWCBinding is an immutable, server-owned account selection and disk baseline.
+// It is never reconstructed from callback parameters or persisted as a credential.
+type SIWCBinding struct {
+	issuer, subject, clientID, accountID string
+	baseline                             [32]byte
+	first                                bool
+}
+
+func (b *SIWCBinding) ClientID() string { return b.clientID }
+
+func siwcString(m map[string]any, key string) string {
+	s, _ := m[key].(string)
+	return s
+}
+
+func siwcBindingBaseline(metadata map[string]any) ([32]byte, error) {
+	doc := ojson.NewDocString("{}")
+	for _, key := range []string{"type", "account_id", "id_token", "access_token", "refresh_token", "siwc"} {
+		if errSet := doc.Set(key, metadata[key]); errSet != nil {
+			return [32]byte{}, errSet
+		}
+	}
+	return sha256.Sum256(doc.Bytes()), nil
+}
+
+// PrepareSIWCBinding selects an existing verified registration or verifies the
+// outer Codex ID token for first binding/legacy migration. No inference is sent.
+// Cross-client subject/workspace equivalence is deliberately fail-closed: when
+// either signed claim is unavailable or differs, binding is not supported.
+func (o *CodexAuth) PrepareSIWCBinding(ctx context.Context, metadata map[string]any) (*SIWCBinding, error) {
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	baseline, errBaseline := siwcBindingBaseline(metadata)
+	if errBaseline != nil {
+		return nil, errSIWCIdentity
+	}
+	section, _ := metadata["siwc"].(map[string]any)
+	if raw, exists := metadata["siwc"]; exists && raw != nil && section == nil {
+		return nil, errSIWCIdentity
+	}
+	for _, key := range []string{"issuer", "subject", "client_id", "bound_account_id", "device_id"} {
+		if raw, exists := section[key]; exists {
+			if _, ok := raw.(string); !ok {
+				return nil, errSIWCIdentity
+			}
+		}
+	}
+	b := &SIWCBinding{clientID: siwcString(section, "client_id"), accountID: siwcString(metadata, "account_id"), baseline: baseline}
+	if b.clientID == SIWCDynamicClientID || strings.TrimSpace(b.clientID) != b.clientID {
+		return nil, errSIWCIdentity
+	}
+	issuer, subject := siwcString(section, "issuer"), siwcString(section, "subject")
+	if issuer != "" || subject != "" {
+		if issuer != siwcIssuer || strings.TrimSpace(subject) == "" || b.clientID == "" || b.accountID == "" || siwcString(section, "bound_account_id") != b.accountID {
+			return nil, errSIWCIdentity
+		}
+		b.issuer, b.subject = issuer, subject
+		return b, nil
+	}
+	if o == nil || o.siwcKeySet == nil || b.accountID == "" {
+		return nil, errSIWCIdentity
+	}
+	// This is evidence from the selected existing login, not a new OAuth grant:
+	// there is no new nonce to compare. Require a currently valid signed token.
+	verifier := oidc.NewVerifier(siwcIssuer, o.siwcKeySet, &oidc.Config{ClientID: ClientID, SupportedSigningAlgs: []string{oidc.RS256}})
+	identity, errVerify := verifier.Verify(ctx, siwcString(metadata, "id_token"))
+	if errVerify != nil || ctx.Err() != nil {
+		return nil, errSIWCIdentity
+	}
+	var claims struct {
+		Auth struct {
+			AccountID string `json:"chatgpt_account_id"`
+		} `json:"https://api.openai.com/auth"`
+		AuthorizedParty string   `json:"azp"`
+		NotBefore       *float64 `json:"nbf"`
+	}
+	now := time.Now()
+	if identity.Claims(&claims) != nil || !identity.Expiry.After(now) ||
+		strings.TrimSpace(identity.Subject) == "" || identity.IssuedAt.IsZero() ||
+		identity.IssuedAt.After(now.Add(5*time.Second)) || !identity.Expiry.After(identity.IssuedAt) ||
+		claims.Auth.AccountID != b.accountID ||
+		(len(identity.Audience) > 1 && claims.AuthorizedParty == "") ||
+		(claims.AuthorizedParty != "" && claims.AuthorizedParty != ClientID) ||
+		(claims.NotBefore != nil && *claims.NotBefore > float64(now.Unix())+5) {
+		return nil, errSIWCIdentity
+	}
+	b.issuer, b.subject, b.first = identity.Issuer, identity.Subject, true
+	return b, nil
+}
+
+// Check must run inside the credential's write lock against its latest contents.
+// Refreshes/rebindings during authorization invalidate the attempt, rather than
+// allowing a late callback to replace newer credentials. Unrelated fields survive.
+func (b *SIWCBinding) Check(ctx context.Context, metadata map[string]any, tokens *CodexSIWCTokenData) error {
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if b == nil || tokens == nil || tokens.Issuer != b.issuer || tokens.Subject != b.subject ||
+		tokens.ClientID == "" || tokens.ClientID == SIWCDynamicClientID ||
+		(b.clientID != "" && tokens.ClientID != b.clientID) {
+		return errSIWCIdentity
+	}
+	if b.first && tokens.AccountID != b.accountID {
+		return errSIWCIdentity
+	}
+	// A signed workspace claim, when supplied on reauthorization, cannot change.
+	if tokens.AccountID != "" && tokens.AccountID != b.accountID {
+		return errSIWCIdentity
+	}
+	baseline, errBaseline := siwcBindingBaseline(metadata)
+	if errBaseline != nil || baseline != b.baseline {
+		return errors.New("SIWC binding target changed; start a new binding")
+	}
+	return nil
+}
+
+// BindAccount records the verified outer association only after Check succeeds.
+func (b *SIWCBinding) BindAccount(tokens *CodexSIWCTokenData) { tokens.BoundAccountID = b.accountID }
+
+// EnsureSIWCHostID persists one host ID per auth-directory runtime before opening
+// a browser. The non-JSON suffix keeps this state out of credential discovery.
+// An existing legacy ID can seed an empty host record, but conflicts are errors.
+func EnsureSIWCHostID(authDir, preferred string) (string, error) {
+	dir, errDir := filepath.EvalSymlinks(authDir)
+	if errDir != nil {
+		return "", errors.New("SIWC host directory is unavailable")
+	}
+	preferred = strings.ToLower(strings.TrimSpace(preferred))
+	if preferred != "" && !IsValidUUID(preferred) {
+		return "", errors.New("invalid saved SIWC host ID")
+	}
+	path := filepath.Join(dir, ".siwc-host.state")
+	var hostID string
+	errLock := WithFileLock(path, func() error {
+		info, errStat := os.Lstat(path)
+		if errStat == nil {
+			if !info.Mode().IsRegular() || info.Mode().Perm()&0o077 != 0 {
+				return errors.New("SIWC host state must be a private regular file")
+			}
+			raw, errRead := os.ReadFile(path)
+			if errRead != nil {
+				return errRead
+			}
+			value := ojson.GetBytes(raw, "device_id")
+			if !ojson.ValidBytes(raw) || value.Type != ojson.String || !IsValidUUID(value.Str) {
+				return errors.New("invalid SIWC host state; refusing to regenerate it")
+			}
+			hostID = strings.ToLower(strings.TrimSpace(value.Str))
+			if preferred != "" && preferred != hostID {
+				return errors.New("saved SIWC registration belongs to a different host")
+			}
+			return nil
+		}
+		if !os.IsNotExist(errStat) {
+			return errStat
+		}
+		hostID = preferred
+		if hostID == "" {
+			hostID = uuid.NewString()
+		}
+		return WriteJSONFileAtomic(path, map[string]any{"device_id": hostID})
+	})
+	return hostID, errLock
+}
