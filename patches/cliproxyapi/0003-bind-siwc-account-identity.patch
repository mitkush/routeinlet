+func TestSIWCFirstBindingRequiresSignedAccountAssociation(t *testing.T) {
+	key, otherKey := siwctest.NewKey(t), siwctest.NewKey(t)
+	auth := &CodexAuth{siwcKeySet: &oidc.StaticKeySet{PublicKeys: []crypto.PublicKey{&key.PublicKey}}}
+	for _, mode := range []string{"valid", "legacy", "signature", "expired", "audience", "workspace", "missing workspace", "subject mismatch", "SIWC workspace mismatch", "SIWC missing workspace"} {
+		t.Run(mode, func(t *testing.T) {
+			signer := key
+			if mode == "signature" {
+				signer = otherKey
+			}
+			outer := siwctest.Token(t, signer, "key", ClientID, "old-login-nonce", func(doc *ojson.Doc) {
+				claims := map[string]any{"https://api\\.openai\\.com/auth.chatgpt_account_id": "account"}
+				switch mode {
+				case "expired":
+					claims["exp"] = time.Now().Add(-time.Hour).Unix()
+				case "audience":
+					claims["aud"] = "other-client"
+				case "workspace":
+					claims["https://api\\.openai\\.com/auth.chatgpt_account_id"] = "other-account"
+				case "missing workspace":
+					delete(claims, "https://api\\.openai\\.com/auth.chatgpt_account_id")
+				}
+				for k, v := range claims {
+					if errSet := doc.Set(k, v); errSet != nil {
+						t.Fatal(errSet)
+					}
+				}
+			})
+			metadata := map[string]any{"type": "codex", "account_id": "account", "id_token": outer, "access_token": "outer", "refresh_token": "refresh"}
+			if mode == "legacy" {
+				metadata["siwc"] = map[string]any{"client_id": "issued", "id_token": "unverified-legacy-token"}
+			}
+			binding, errPrepare := auth.PrepareSIWCBinding(context.Background(), metadata)
+			prepareOK := mode == "valid" || mode == "legacy" || strings.HasPrefix(mode, "SIWC ") || mode == "subject mismatch"
+			if !prepareOK {
+				if errPrepare == nil {
+					t.Fatal("unverified outer identity accepted")
+				}
+				return
+			}
+			if errPrepare != nil {
+				t.Fatal(errPrepare)
+			}
+			token := &CodexSIWCTokenData{ClientID: "issued", IDToken: siwctest.Token(t, key, "key", "issued", "new-nonce", func(doc *ojson.Doc) {
+				account := "account"
+				if mode == "SIWC workspace mismatch" {
+					account = "other"
+				}
+				if mode != "SIWC missing workspace" {
+					if errSet := doc.Set("https://api\\.openai\\.com/auth.chatgpt_account_id", account); errSet != nil {
+						t.Fatal(errSet)
+					}
+				}
+				if mode == "subject mismatch" {
+					if errSet := doc.Set("sub", "other-subject"); errSet != nil {
+						t.Fatal(errSet)
+					}
+				}
+			})}
+			if errVerify := auth.verifySIWCIDToken(context.Background(), token, "new-nonce"); errVerify != nil {
+				t.Fatal(errVerify)
+			}
+			errCheck := binding.Check(context.Background(), metadata, token)
+			if mode != "valid" && mode != "legacy" {
+				if errCheck == nil {
+					t.Fatal("different or unproven account accepted")
+				}
+				return
+			}
+			if errCheck != nil {
+				t.Fatal(errCheck)
+			}
+			binding.BindAccount(token)
+			saved := token.ToMap()
+			if saved["issuer"] != siwcIssuer || saved["subject"] != "synthetic-subject" || saved["bound_account_id"] != "account" {
+				t.Fatal("lost verified identity")
+			}
+		})
+	}
+}
