+func TestSIWCHostIDPersistsAcrossAttemptsAndProcesses(t *testing.T) {
+	dir := t.TempDir()
+	const preferred = "e61bbe28-07ef-466d-8e5d-a344f94ab305"
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			id, errHost := EnsureSIWCHostID(dir, preferred)
+			if errHost != nil || id != preferred {
+				t.Errorf("host creation: %v", errHost)
+			}
+		}()
+	}
+	wg.Wait()
+	command := exec.Command(os.Args[0], "-test.run=^TestSIWCHostProcessHelper$")
+	command.Env = append(os.Environ(), "SIWC_TEST_HOST_DIR="+dir, "SIWC_TEST_HOST_ID="+preferred)
+	if out, errRun := command.CombinedOutput(); errRun != nil {
+		t.Fatalf("restart: %v %s", errRun, out)
+	}
+	info, errStat := os.Stat(filepath.Join(dir, ".siwc-host.state"))
+	if errStat != nil || info.Mode().Perm() != 0o600 {
+		t.Fatal("host file is not private")
+	}
+	if _, errConflict := EnsureSIWCHostID(dir, "11111111-1111-1111-1111-111111111111"); errConflict == nil {
+		t.Fatal("host conflict accepted")
+	}
+}
+
+func TestSIWCHostProcessHelper(t *testing.T) {
+	dir := os.Getenv("SIWC_TEST_HOST_DIR")
+	if dir == "" {
+		t.Skip("subprocess helper")
+	}
+	id, errHost := EnsureSIWCHostID(dir, "")
+	if errHost != nil || id != os.Getenv("SIWC_TEST_HOST_ID") {
+		t.Fatal("host identity changed after restart")
+	}
+}
+
+func TestSIWCHostStateFailsClosed(t *testing.T) {
+	for _, mode := range []string{"malformed", "permissions", "symlink"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, ".siwc-host.state")
+			original := []byte(`{"device_id":"11111111-1111-1111-1111-111111111111"}`)
+			if mode == "malformed" {
+				original = []byte(`broken`)
+			}
+			target := path
+			if mode == "symlink" {
+				target = filepath.Join(dir, "elsewhere")
+			}
+			if errWrite := os.WriteFile(target, original, 0o600); errWrite != nil {
+				t.Fatal(errWrite)
+			}
+			if mode == "permissions" {
+				if errMode := os.Chmod(path, 0o644); errMode != nil {
+					t.Fatal(errMode)
+				}
+			}
+			if mode == "symlink" {
+				if errLink := os.Symlink(target, path); errLink != nil {
+					t.Fatal(errLink)
+				}
+			}
+			if _, errHost := EnsureSIWCHostID(dir, ""); errHost == nil {
+				t.Fatal("unsafe host file accepted")
+			}
+			after, errRead := os.ReadFile(target)
+			if errRead != nil || string(after) != string(original) {
+				t.Fatal("invalid state overwritten")
+			}
+		})
+	}
+}
