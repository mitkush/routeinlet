+func TestSIWCBindingRejectsStaleSelections(t *testing.T) {
+	metadata := map[string]any{"account_id": "account", "siwc": map[string]any{"issuer": siwcIssuer, "subject": "subject", "client_id": "issued", "bound_account_id": "account", "refresh_token": "old"}}
+	binding, errPrepare := NewCodexAuth(nil).PrepareSIWCBinding(context.Background(), metadata)
+	if errPrepare != nil {
+		t.Fatal(errPrepare)
+	}
+	token := &CodexSIWCTokenData{Issuer: siwcIssuer, Subject: "subject", ClientID: "issued"}
+	metadata["note"] = "new note"
+	if errCheck := binding.Check(context.Background(), metadata, token); errCheck != nil {
+		t.Fatal(errCheck)
+	}
+	for _, mode := range []string{"subject", "client", "disk", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			candidate := *token
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			switch mode {
+			case "subject":
+				candidate.Subject = "different"
+			case "client":
+				candidate.ClientID = "other"
+			case "disk":
+				metadata["siwc"].(map[string]any)["refresh_token"] = "newer"
+				defer func() { metadata["siwc"].(map[string]any)["refresh_token"] = "old" }()
+			case "cancel":
+				cancel()
+			}
+			if binding.Check(ctx, metadata, &candidate) == nil {
+				t.Fatal("unsafe selection accepted")
+			}
+		})
+	}
+}
