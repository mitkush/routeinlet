+// The HTTP upgrade can finish before commitPeer. A control response proves the
+// server read loop has started after registration, without sleeping or polling.
+func awaitTunnelServerRegistration(t *testing.T, conn *websocket.Conn) {
+	t.Helper()
+	if errWrite := conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"list_servers","request_id":"registration-barrier"}`)); errWrite != nil {
+		t.Fatalf("registration barrier write: %v", errWrite)
+	}
+	frame := readTextJSONFrame(t, conn)
+	if frame.Get("type").String() != ControlTypeError ||
+		frame.Get("code").String() != ErrCodeUnsupportedRoleAction ||
+		frame.Get("request_id").String() != "registration-barrier" {
+		t.Fatalf("unexpected server registration barrier response: %s", frame.Raw)
+	}
+}
